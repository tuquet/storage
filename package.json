{
  "name": "tuquet-storage",
  "version": "2.7.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ./frontend-dist --d1 img_d1 --r2 img_r2 --kv img_url --ip 127.0.0.1 --port 8080 --persist-to ./data",
    "test": "vitest run || mocha",
    "d1:init:local": "wrangler d1 execute img_d1 --local --file=database/schema.sql",
    "start": "wrangler pages dev ./frontend-dist --d1 img_d1 --r2 img_r2 --kv img_url --ip 127.0.0.1 --port 8080 --persist-to ./data",
    "deploy:worker": "node deploy/worker/generate-routes.js && wrangler deploy --config deploy/worker/wrangler.toml"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@cloudflare/pages-plugin-sentry": "^1.1.3",
    "@sentry/tracing": "^7.114.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "miniflare": "^4.20260708.1",
    "mocha": "^8.1.3",
    "vitest": "^2.1.8",
    "wait-on": "^7.2.0",
    "wrangler": "^4.24.0"
  }
}
